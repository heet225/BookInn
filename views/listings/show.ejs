<% layout ("layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-3">
    <h3><%= ListingData.title %></h3>
    </div>
    <div class="card col-6 offset-3 show-card listing-card mb-5">
  <img src="<%= ListingData.image %>" class="card-img-top show-img" alt="listing-image">
  <div class="card-body">
    <p class="card-text">Owned by: <i><%= ListingData.owner.username %></i>
       <p class="card-text"> <%= ListingData.description %> </p>
       <p class="card-text"> &#x20b9;<%= ListingData.price.toLocaleString('en-IN') %></p>
        <p class="card-text"><%= ListingData.location %> </p>
        <p class="card-text"><%= ListingData.country %></p>
    </p>
  </div>
</div>
<% if(currentUser && currentUser._id.equals(ListingData.owner._id)) { %>
<div class="btns">
    <a href="/listings/<%= ListingData._id %>/edit" class="btn btn-dark col-1 offset-3">Edit</a>

            <form action="/listings/<%= ListingData._id %>?_method=DELETE" method="POST">
                <button type="submit" class="btn btn-danger  offset-5">Delete</button>
            </form>
            </div>
<% } %>
            <div class="review-section col-8 offset-3 mt-5">
                <hr>
                <h4>reviews</h4>
                <div class="row">
                    <% for(let review of ListingData.reviews) { %>
                        <div class="card mb-3 col-5 ms-3">
                            <div class="card-body">
                                <h5 class="card-title">@<%= review.author.username %></h5>
                                <p class="card-text"><b>Rating: <%= review.rating %> / 5</b></p>
                                <p class="card-text"><%= review.comment %></p>
                        </div>
                        <form action="/listings/<%= ListingData._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="mb-3">
                            <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                    </div>
                    <% } %>
                    </div>
                    <% if(currentUser) { %>
                <h4>Add a Review</h4>
                <form action="/listings/<%= ListingData._id %>/reviews" method="POST" novalidate class="needs-validation">
                    <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">Rating</label>
                        <input type="range" class="form-range mb-3" min="1" max="5" id="rating" name="review[rating]">
                    </div>
                    <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">comment</label>
                    <textarea class="form-control" id="comment" rows="5" cols="30" 
                    placeholder="enter your comment" name="review[comment]" required></textarea>
                    <div class="invalid-feedback">Please add some comment for your review.</div>
                    </div>
                    <button type="submit" class="btn btn-outline-dark">Submit Review</button>
                </form>
                <% } else { %>
                    <h5>Please <a href="/login">login</a> to add a review.</h5>
                    <% } %>
            </div>
    </div>
</body>
